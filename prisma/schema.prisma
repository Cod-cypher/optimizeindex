generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  WON
  LOST
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // What the visitor submitted
  type       String // quote_page | audit_page | modal_quote | modal_audit
  name       String?
  email      String
  phone      String?
  company    String?
  website    String
  competitor String?
  goal       String? // revenue | profit | conversions | cac | roi
  service    String? // gmb | seo | aeo | geo | paid-search | ...
  budget     String?
  comments   String?

  // Marketing attribution — mirrors what we sell: channel-level ROI tracking
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  referrer      String?
  landingPage   String? // first page of the session
  submittedFrom String? // page the form was submitted on
  gaClientId    String? // GA4 client id for cross-referencing analytics

  // Journey linkage — join to Visitor/Session/PageView/Event for the full
  // pre-conversion story (pages viewed, time on site, sessions to convert)
  visitorId String?
  sessionId String?
  // The instant audit this lead came out of, when it came from the hero tool
  auditId   String?

  // Technical context
  userAgent String?
  ipAddress String?

  // Delivery + sales pipeline for business analysis
  emailForwarded Boolean    @default(false)
  status         LeadStatus @default(NEW)
  followUpNotes  String?

  @@index([email])
  @@index([createdAt])
  @@index([status])
  @@index([type])
  @@index([utmSource, utmMedium, utmCampaign])
  @@index([visitorId])
  @@index([sessionId])
  @@index([auditId])
}

// One row per instant audit run from the homepage hero. Written whether or
// not the visitor ever hands over an email — the domains people check are
// lead intelligence on their own, and the row doubles as a 6-hour cache so a
// repeat scan costs neither a crawl nor a PageSpeed call.
model SiteAudit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  url      String // what the visitor typed, normalized
  finalUrl String? // after redirects
  domain   String // registrable host, www stripped — the cache key

  overallScore     Int?
  technicalScore   Int?
  contentScore     Int?
  performanceScore Int?
  geoScore         Int?

  // Core Web Vitals, once PageSpeed has answered
  psiFetched Boolean @default(false)
  lcpMs      Int?
  clsScore   Float?
  inpMs      Int?
  cwvSource  String? // field | lab — never conflate the two

  // Full category + check payload, so a report can be regenerated later
  checks Json?

  // Set when the scan failed, so failure patterns are visible
  errorCode String?

  // Who ran it
  visitorId String?
  sessionId String?
  leadEmail String? // filled in if they went on to submit the form
  ipAddress String?
  userAgent String?

  durationMs Int?

  @@index([domain])
  @@index([createdAt])
  @@index([leadEmail])
  @@index([visitorId])
}

// One row per unique browser (anonymous id persisted in localStorage).
// First-touch attribution lives here; answers "which channel creates
// visitors that eventually convert, even weeks later?"
model Visitor {
  id          String   @id // client-generated
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  firstReferrer    String?
  firstLandingPage String?
  firstUtmSource   String?
  firstUtmMedium   String?
  firstUtmCampaign String?

  deviceType String? // mobile | tablet | desktop
  browser    String?
  os         String?
  language   String?
  timezone   String?
  country    String?

  sessionCount Int       @default(1)
  convertedAt  DateTime? // set on first lead submission
  leadEmail    String? // ties anonymous history to the identified lead

  @@index([firstSeenAt])
  @@index([convertedAt])
  @@index([firstUtmSource, firstUtmMedium, firstUtmCampaign])
}

// One row per visit (30-minute inactivity window). Duration is
// lastActivityAt - startedAt; bounce = pageViewCount 1 and no events.
model Session {
  id             String   @id // client-generated
  visitorId      String
  startedAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  entryPage String?
  exitPage  String?
  referrer  String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  deviceType   String?
  browser      String?
  os           String?
  screenWidth  Int?
  screenHeight Int?
  language     String?
  timezone     String?
  country      String?
  ipAddress    String?
  userAgent    String?

  pageViewCount Int     @default(0)
  eventCount    Int     @default(0)
  isConverted   Boolean @default(false) // a lead was submitted this session

  @@index([visitorId])
  @@index([startedAt])
  @@index([isConverted])
  @@index([utmSource, utmMedium, utmCampaign])
}

// One row per page seen, with engagement quality (time + scroll depth).
model PageView {
  id        String   @id // client-generated so duration/scroll update the same row
  sessionId String
  visitorId String
  path      String
  title     String?
  startedAt DateTime @default(now())

  durationMs   Int? // filled in when the visitor leaves the page
  maxScrollPct Int? // deepest scroll reached, 0-100

  @@index([sessionId])
  @@index([visitorId])
  @@index([path])
  @@index([startedAt])
}

// Every meaningful interaction: CTA clicks (by element id), goal-pill
// selections, phone/email taps, form starts, form submissions, outbound
// clicks. `name` is the event type, `label` the specific target.
model Event {
  id        String   @id @default(cuid())
  sessionId String
  visitorId String
  createdAt DateTime @default(now())

  name     String // click | phone_click | email_click | outbound_click | form_start | form_submit | form_error | goal_selected | session_start
  label    String? // element id, href, goal id, form name...
  path     String? // page where it happened
  metadata Json? // free-form extras (link text, href, etc.)

  @@index([sessionId])
  @@index([visitorId])
  @@index([name, createdAt])
  @@index([createdAt])
}

/**
 * ---------------------------------------------------------------------------
 * Proposal portal
 * ---------------------------------------------------------------------------
 * An admin builds a personalized growth proposal for a prospect and publishes
 * it to a human-readable slug (optimizeindex.com/abc-logistics). The prospect
 * opens the link; the admin sees whether they actually did.
 * These pages carry a named prospect's business data, so they are served
 * noindex/nofollow and never enter sitemap.xml.
 * ---------------------------------------------------------------------------
 */

enum ProposalStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Staff login. A table rather than a password in .env, so the password can be
/// rotated and a second seat added without a redeploy.
/// Seed with: npm run admin -- <email> <password>
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  /// scrypt, stored as "<saltHex>:<derivedKeyHex>". See server/auth.ts.
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  isActive     Boolean   @default(true)

  proposals      Proposal[]
  savedTemplates SavedTemplate[]
}

model Proposal {
  id          String         @id @default(cuid())
  /// The public URL segment: optimizeindex.com/<slug>. Checked against a
  /// reserved list (see server/proposals/slug.ts) so a proposal can never
  /// shadow /services, /admin, /api or a static asset.
  slug        String         @unique
  status      ProposalStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  publishedAt DateTime?
  /// Optional. Past this, the page stops rendering.
  expiresAt   DateTime?
  /// Optional gate. Null means the slug alone is the key, which is the default
  /// because these links get sent by text and pasted into email.
  accessCode  String?

  authorId String
  author   AdminUser @relation(fields: [authorId], references: [id])

  // --- Company ---
  companyName   String
  contactName   String?
  email         String?
  phone         String?
  websiteUrl    String?
  city          String?
  state         String?
  /// Miles.
  serviceRadius Int?
  industry      String?
  fleetSize     Int?
  /// string[] — "flatbed", "heavy duty wrecker", ...
  truckTypes    Json?
  heroImageUrl  String?
  logoImageUrl  String?

  // --- Current situation ---
  /// Average inbound calls per month, as reported by the prospect.
  currentCalls Int?
  /// [{ source, share?, calls?, note? }]
  callSources  Json?
  currentNotes String?

  // --- Opportunity ---
  // Scalars, not JSON: these are the numbers worth querying across proposals.
  projectedCalls  Int?
  /// Cents.
  avgJobValue     Int?
  timeframeMonths Int?
  /// Required before publishing whenever projectedCalls is set. A projection
  /// with no stated basis is a fabricated statistic, which this codebase does
  /// not ship — see the deliberately empty `sameAs` in src/routes.ts.
  projectionBasis String?

  // --- Plan / pricing / CTA ---
  /// [{ title, timeline, items: string[] }]
  phases         Json?
  /// string[]
  deliverables   Json?
  /// Cents. Null hides the whole investment section.
  monthlyPrice   Int?
  setupFee       Int?
  termMonths     Int?
  ctaLabel       String?
  ctaUrl         String?
  /// [{ heading, body }] — escape hatch for one-off sections.
  customSections Json?

  /// Internal only. Stripped by toPublicProposal() and never sent to the page.
  adminNotes String?

  views  ProposalView[]
  events ProposalEvent[]

  @@index([status])
  @@index([createdAt])
  @@index([authorId])
}

/// One row per page render of a published proposal.
///
/// `confirmed` is the important column. Gmail and Outlook prefetch links in
/// email, so a raw render count reports "viewed 3 times" seconds after the
/// message is sent. The server writes the row unconfirmed; a beacon fired 3
/// seconds into a real browser session flips it. Only confirmed rows are shown
/// as views.
model ProposalView {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  viewedAt   DateTime @default(now())

  /// Anonymous per-proposal id from localStorage. Separates "one prospect
  /// opened it four times" from "four people opened it".
  viewerKey    String?
  confirmed    Boolean @default(false)
  isBot        Boolean @default(false)
  durationMs   Int?
  maxScrollPct Int?

  ipAddress String?
  userAgent String?
  referrer  String?

  @@index([proposalId, viewedAt])
  @@index([viewerKey])
}

model ProposalEvent {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  /// cta_click | section_view | phone_click | email_click | reply_submit
  name      String
  label     String?
  viewerKey String?
  metadata  Json?

  @@index([proposalId, createdAt])
  @@index([name])
}

/// A template the admin saved from a proposal they had already built.
///
/// Named SavedTemplate rather than ProposalTemplate so it cannot be confused
/// with the built-in verticals in shared/proposalTemplates.ts, which are code,
/// not rows. Both end up side by side in the picker.
///
/// `fields` holds the same allowlisted shape the built-ins use, and holds only
/// the groups the admin ticked when saving — which may include findings about
/// the prospect it was built from: contact details, call volumes, the
/// projection and its basis. That is deliberate; see the header of
/// server/proposals/templates.ts for why, and note that it makes a row here
/// worth the same care as the proposal it came from.
///
/// Rows are scoped to their author. The picker labels them "Yours".
model SavedTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  fields      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String
  author   AdminUser @relation(fields: [authorId], references: [id])

  @@index([createdAt])
  @@index([authorId])
}
