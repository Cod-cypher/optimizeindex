# DATABASE_URL: PostgreSQL connection string.
# Backs leads, first-party analytics (Visitor/Session/PageView/Event) and the
# instant site audit (SiteAudit). Required — the app runs without it, but every
# write falls back to leads.json and nothing is queryable.
DATABASE_URL="postgresql://user:password@localhost:5432/optimizeindex"

# PORT: HTTP port for the Express server. Defaults to 3000.
# Production runs on 3002 behind nginx (see ecosystem.config.cjs).
PORT="3000"

# PAGESPEED_API_KEY: Google PageSpeed Insights API key.
# Powers the Core Web Vitals half of the homepage instant audit.
# Strongly recommended: without a key Google rate-limits the endpoint so
# aggressively that most visitors get no speed data at all. Free to create at
# https://console.cloud.google.com/apis/credentials (enable the "PageSpeed
# Insights API"), and free for 25,000 requests/day.
# The audit degrades gracefully when this is absent — the other three
# categories still score, and the speed card says it wasn't measured.
PAGESPEED_API_KEY=""

# SESSION_SECRET: signing key for admin session cookies. REQUIRED in production
# — the server refuses to start without it rather than issue sessions it cannot
# verify. Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this value invalidates every signed-in admin session, which is how
# you force a logout everywhere.
# In development a random per-process value is used if this is unset, so `npm
# run dev` works out of the box; restarting just signs you out.
SESSION_SECRET=""

# Outbound mail (lead notifications).
# When these are set, leads are emailed through this SMTP server. If they are
# not set, the server falls back to FormSubmit, which requires a one-time
# activation click per recipient address before it delivers anything.
#
# SMTP_SECURE is optional: it defaults to true on port 465 (implicit TLS) and
# false on 587 (STARTTLS). Set it only to override that.
# MAIL_FROM must be a mailbox this server is permitted to send as, or the
# message will be rejected or land in spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
MAIL_FROM=

# IndexNow key: any 8-128 hex chars, generate once and never change it.
# `npm run indexnow` writes public/<key>.txt and pings Bing. Unset = no-op.
INDEXNOW_KEY=

# --- Chat widget ---------------------------------------------------------
#
# All optional. With OPENAI_API_KEY unset the widget still appears and still
# works — it degrades to a contact form that posts to /api/leads. That is
# deliberate: an outage should look like a plainer widget, not a broken one.
# The boot log says which mode is live.
#
# OPENAI_MODEL: verified current 2026-09-09. Cost tiers, cheapest first:
#   gpt-5.6-luna ($0.20/$1.20 per 1M) -> gpt-5.6-terra -> gpt-5.6 (Sol)
# Note that no `temperature` is sent — the current reasoning models reject
# sampling parameters outright, so response style is controlled entirely by
# the prompt rules in src/content/chat.ts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# none | low | medium | high. "none" is lowest latency and the default here.
# Raising it also means raising MAX_OUTPUT_TOKENS in server/chat/openai.ts,
# because that cap counts reasoning tokens as well as visible ones.
OPENAI_REASONING_EFFORT=none

# Kill switch that does not require deleting the key. "false" = form mode.
CHAT_ENABLED=true

# Where the "a visitor wants a person" email goes, and what the visitor sees
# when that person joins the conversation.
CHAT_HANDOFF_EMAIL=ali@optimizeindex.com
CHAT_AGENT_LABEL=Ali

# Runaway-abuse backstop, not a budget. 5M tokens is roughly $2-4/month at
# Luna pricing; over the cap the widget serves form mode for the rest of the
# calendar month. Re-check against real usage after the first month rather
# than guessing twice.
CHAT_MONTHLY_TOKEN_CAP=5000000

# Assistant replies per conversation before it stops guessing and hands over.
CHAT_MAX_TURNS=25

# Where chat join links point. Leave unset in production, where SITE_ORIGIN
# (https://optimizeindex.com) is used. Set it when testing the handoff against
# a dev server or a staging box, otherwise the emailed link points at the live
# site and 404s there.
PUBLIC_ORIGIN=
